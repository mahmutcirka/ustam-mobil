---
import Layout from '../../layouts/Layout.astro';
import Iskelet from "../../components/Iskelet.astro";
import UstaDetay from '../../components/UstaDetay.svelte';
import { ustalar } from '$lib/data';
import type { Usta } from "../../lib/types";

export function getStaticPaths() {
  return ustalar.map((u) => ({
    params: { id: String(u.id) },
    props: { usta: u },
  }));
}

interface Props {
  usta: Usta;
}

const { usta } = Astro.props;
---

<Layout title={`${usta.ad} — Ustam`}>
  <UstaDetay client:only="svelte" usta={usta} >
    <Iskelet slot="fallback" tur="detay" />
  </UstaDetay>
</Layout>
